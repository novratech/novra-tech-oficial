  /* site novo da Kira: uma página inteira que rola sozinha dentro da tela. Tudo é medido pela
     própria tela (cqw e cqh), então serve para o computador e, num recipiente estreito, vira a
     versão de celular. Cada bloco tem a altura da tela, e a rolagem para em cada um. */
  .km { container: km / size; --nav: 7cqw; position: absolute; inset: 0; display: flex; flex-direction: column; overflow: hidden; background: #fbf9f6; color: #221d17; font-family: var(--font); text-align: left; }
  .km__nav { position: relative; z-index: 2; flex: none; display: flex; align-items: center; gap: 2.6cqw; height: var(--nav); padding: 0 4cqw; background: #fbf9f6; border-bottom: 1px solid rgba(43, 38, 32, 0.08); }
