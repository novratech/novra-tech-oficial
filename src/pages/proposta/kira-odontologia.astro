  :global(.show-cta) .kh__cta, :global(html:not(.js)) .kh__cta { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  @media (max-width: 420px) { .kh__cli { font-size: 13px; } .kh__brand img { height: 22px; } }

  /* ---------- folhas claras ---------- */
  .sheet { border-radius: 32px; }

  /* cabeçalho de seção */
  .k-head { max-width: 46rem; }
