<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const AUTO_MS = 3500;

  // título do Google "sendo escrito" quando entra o depois
  function typeOut(el: HTMLElement) {
    const full = el.dataset.type || '';
    const t = (el as any)._t;
    if (t) clearInterval(t);
    if (reduce) { el.textContent = full; return; }
    let i = 0;
    el.textContent = '';
    el.classList.add('is-typing');
    (el as any)._t = setInterval(() => {
      i += 1;
      el.textContent = full.slice(0, i);
      if (i >= full.length) { clearInterval((el as any)._t); el.classList.remove('is-typing'); }
    }, 22);
  }

  // antes x depois: mostra o hoje, vira para o depois uma vez e para ali
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-ba-btn]')];
    let timer: number | null = null;
    const stop = () => { if (timer) { clearTimeout(timer); timer = null; } };
    const halt = () => { root.dataset.touched = '1'; stop(); };
    const set = (state: string) => {
      if (root.dataset.state === state) return;
      root.dataset.state = state;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.baBtn === state)));
      root.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        if (state === 'depois') typeOut(el);
        else { const t = (el as any)._t; if (t) clearInterval(t); el.classList.remove('is-typing'); el.textContent = el.dataset.type || ''; }
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => { halt(); set(b.dataset.baBtn || 'hoje'); }));
    root.querySelector('[data-ba-frame]')?.addEventListener('click', () => { halt(); set(root.dataset.state === 'hoje' ? 'depois' : 'hoje'); });
    root.addEventListener('focusin', halt);
    if (reduce || !hasIO) return;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !root.dataset.touched) {
        if (!timer) timer = window.setTimeout(() => { timer = null; set('depois'); root.dataset.touched = '1'; }, AUTO_MS);
      } else stop();
    }, { threshold: 0.25 }).observe(root);
  });

  // calendário acende dia a dia; preço antigo é riscado
  const onView = (sel: string, threshold = 0.35) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    if (reduce || !hasIO) { el.classList.add('is-on'); return; }
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { el.classList.add('is-on'); o.disconnect(); } }, { threshold }).observe(el);
  };
  onView('[data-cal]');
  onView('[data-inv]', 0.5);

  // barra fixa: aparece depois do topo, some sobre o investimento e no fechamento
  const bar = document.querySelector<HTMLElement>('.kbar');
  const hero = document.querySelector<HTMLElement>('.k-hero');
  const inv = document.querySelector<HTMLElement>('[data-inv]');
  const fim = document.getElementById('fim');
  if (bar && hero && fim && hasIO) {
    let past = false;
    let onInv = false;
    let end = false;
    const sync = () => { const on = past && !onInv && !end; bar.classList.toggle('is-on', on); bar.inert = !on; };
    new IntersectionObserver(([e]) => { past = !e.isIntersecting; sync(); }).observe(hero);
    if (inv) new IntersectionObserver(([e]) => { onInv = e.isIntersecting; sync(); }, { threshold: 0.2 }).observe(inv);
    new IntersectionObserver(([e]) => { end = e.isIntersecting; sync(); }, { threshold: 0.05 }).observe(fim);
  }
</script>
