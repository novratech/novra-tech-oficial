---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const WHATSAPP = '5511998002960';
const WHATSAPP_FMT = '(11) 99800-2960';
const WA_TEXT = encodeURIComponent('Olá, sou da Kira Odontologia e quero falar sobre a proposta.');
const waLink = `https://wa.me/${WHATSAPP}?text=${WA_TEXT}`;

const EMITIDA = '01/10/2026';
const VALIDA_ATE = '08/10/2026';

// glifo do WhatsApp (o Icon.astro não tem marcas)
const WA_PATH =
  'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.78h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41';

const entregas = [
  {
    icon: 'devices', titulo: 'Página principal', preco: 'R$ 2.000',
    prova: { tipo: 'browser', img: 'akaki-galeria.webp', w: 1440, h: 668, url: 'https://akaki.odo.br/', label: 'akaki.odo.br', pos: 'left top' },
    pontos: ['Um bloco para cada tratamento', 'Equipe com foto, nome e CRO', 'WhatsApp e rota em um toque'],
    mais: [
      'Topo com uma frase',
      'A clínica por dentro, com fotos reais',
      'Perguntas frequentes, mapa, horário e estacionamento',
      'Formulário enxuto, que não pergunta sintoma nem histórico',
      'Nome certo no Google e prévia com foto ao compartilhar',
      'Links antigos continuam abrindo',
      'Textos escritos pela NOVRA, com duas rodadas de ajuste',
    ],
  },
  {
    icon: 'search', titulo: 'Blog', preco: 'R$ 1.500',
    prova: { tipo: 'browser', img: 'akaki-blog.webp', w: 1600, h: 1000, url: 'https://www.akaki.odo.br/blog/', label: 'akaki.odo.br/blog', pos: 'center top' },
    pontos: ['Os 10 artigos atuais reorganizados', 'Temas prontos, dentro das regras do CFO', 'A própria equipe publica'],
    mais: [
      'Visual novo, com listagem por assunto',
      'Link curto, e o antigo leva para o novo',
      'Lista de temas para os próximos artigos',
      'Todo artigo assinado por dentista, com CRO',
      'Modelo de artigo pronto e vídeo ensinando a publicar',
    ],
  },
  {
    icon: 'menu', titulo: 'Links da bio', preco: 'R$ 800',
    prova: { tipo: 'phone', img: 'akaki-bio-recorte.webp', w: 860, h: 1225, url: 'https://link.bio.akaki.odo.br/', label: 'link.bio.akaki.odo.br', pos: 'center top' },
    pontos: ['Com fotos e marca da própria Kira', 'Dentro do site da Kira', 'Vocês veem o botão mais clicado'],
    mais: [
      'Mesmas cores, tipografia e fotos do site novo',
      'WhatsApp com mensagem pronta, rota e principais tratamentos',
      'Contagem de cliques sem identificar ninguém',
      'Edição pela própria equipe, sem depender de ninguém',
      'Leve, para abrir rápido no celular',
    ],
  },
];

const placar = [
  { valor: '1', label: 'palavra no título do Google' },
  { valor: '0', label: 'fotos no link enviado pelo WhatsApp' },
  { count: 1.5, decimals: 1, suffix: ' MB', fallback: '1,5 MB', label: 'numa imagem gerada por IA, na página inicial' },
  { count: 132, decimals: 0, suffix: '', fallback: '132', label: 'dias sem artigo novo no blog' },
];

// etapas do calendário: cada dia útil pintado pela etapa
const etapas = [
  { cls: 'e1', dias: 'Dia 1', titulo: 'Conversa de 1 hora', sub: 'Vocês mandam fotos e acessos' },
  { cls: 'e2', dias: 'Dias 2 a 4', titulo: 'Desenho e textos', sub: 'A NOVRA escreve tudo' },
  { cls: 'e3', dias: 'Dia 5', titulo: 'Sua aprovação', sub: 'Primeira rodada de ajustes' },
  { cls: 'e4', dias: 'Dias 6 a 8', titulo: 'Construção', sub: 'As três peças montadas' },
  { cls: 'e5', dias: 'Dias 9 e 10', titulo: 'No ar', sub: 'Aprovação final e publicação' },
];
const diaEtapa = ['e1', 'e2', 'e2', 'e2', 'e3', 'e4', 'e4', 'e4', 'e5', 'e5'];
const semana = ['S', 'T', 'Q', 'Q', 'S'];

const passos = [
  { icon: 'check', titulo: 'Aprovar por escrito', sub: 'R$ 3.784 à vista' },
  { icon: 'mail', titulo: 'Enviar o material', sub: 'Fotos, equipe e acessos' },
  { icon: 'clock', titulo: 'Conversa de 1 hora', sub: 'Presencial ou online' },
];
---

<Base
  title="Proposta · Kira Odontologia · NOVRA"
  description="Página principal, blog e bio novos para a Kira Odontologia. No ar em 2 semanas."
  noindex={true}
  image="/proposta/kira/og.jpg"
  intro={false}
>
  <header class="kh">
    <div class="container kh__in">
      <a href="/" class="kh__logo" aria-label="NOVRA">
        <img src="/brand/novra-logo-branco.svg" alt="NOVRA" width="874" height="227" />
      </a>
      <span class="kh__x" aria-hidden="true">×</span>
      <span class="kh__cli">Kira Odontologia</span>
    </div>
  </header>

  <main id="main">

    <!-- ===== TOPO ===== -->
    <section class="k-hero">
      <span class="k-glow" aria-hidden="true"><span class="glow-orb k-hero__orb"></span></span>
      <div class="container k-hero__grid">
        <div class="k-hero__copy">
          <span class="eyebrow k-hero__eb" data-reveal>Proposta · {EMITIDA}</span>
          <h1 class="k-hero__h balance" data-reveal>No Google, o seu site se chama só <span class="text-gold">“Kira”</span>.</h1>
          <p class="k-hero__lead pretty" data-reveal>Página principal, blog e bio novos, com o nome, a equipe e as fotos de vocês.</p>
          <ul class="k-chips" data-reveal>
            <li><Icon name="layers" size={16} /> 3 entregas</li>
            <li><Icon name="clock" size={16} /> 2 semanas</li>
            <li><Icon name="check" size={16} /> Vale até 08/10</li>
          </ul>
          <div class="k-hero__cta" data-reveal>
            <a href="#entregas" class="btn btn-primary btn-lg" data-magnetic data-offset="16" data-no-hash>
              Ver entregas e valor <Icon name="arrow-down" />
            </a>
            <a href={waLink} target="_blank" rel="noopener" class="btn btn-ghost btn-lg" data-magnetic>Falar no WhatsApp</a>
          </div>
        </div>

        <!-- Google: hoje x depois -->
        <div class="ba serp-ba" data-ba data-state="hoje" data-reveal>
          <div class="ba-tabs" role="group" aria-label="Como a clínica aparece no Google">
            <button type="button" class="ba-tab" data-ba-btn="hoje" aria-pressed="true">Hoje</button>
            <button type="button" class="ba-tab" data-ba-btn="depois" aria-pressed="false">Com a NOVRA</button>
          </div>
          <div class="g-frame" data-ba-frame>
            <div class="g-chrome" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="g-tab ba-stack"><span class="ba-hoje">Kira</span><span class="ba-depois">Kira Odontologia</span></span>
            </div>
            <div class="g-body ba-stack">
              <div class="g-res ba-hoje">
                <div class="g-site">
                  <img class="g-fav" src="/proposta/kira/kira-icone.webp" alt="" width="72" height="72" />
                  <span><b>kiraodontologia.com.br</b><small>https://kiraodontologia.com.br</small></span>
                </div>
                <p class="g-title">Kira</p>
                <p class="g-miss">Texto escolhido pelo Google, não pela clínica.</p>
              </div>
              <div class="g-res ba-depois">
                <div class="g-site">
                  <img class="g-fav" src="/proposta/kira/kira-icone.webp" alt="" width="72" height="72" />
                  <span><b>Kira Odontologia</b><small>https://kiraodontologia.com.br</small></span>
                </div>
                <p class="g-title" data-type="Kira Odontologia · Implantes e estética no Jardim Paulista">Kira Odontologia · Implantes e estética no Jardim Paulista</p>
                <p class="g-desc">Clínica odontológica no Jardim Paulista, perto da Av. Paulista. Implantes, facetas e Invisalign. Agende pelo WhatsApp.</p>
              </div>
            </div>
          </div>
          <p class="ba-hint">Toque na tela para comparar</p>
        </div>
      </div>
    </section>

    <!-- ===== DIAGNÓSTICO ===== -->
    <section class="k-sec k-hoje">
      <div class="container">
        <div class="k-head" data-reveal>
          <span class="eyebrow">Diagnóstico</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="k-h2 balance">O que a paciente vê <span class="text-gradient">antes de marcar.</span></h2>
        </div>

        <div class="hoje__vis">
          <figure class="hoje__fig" data-reveal>
            <figcaption class="k-cap"><b>Página Sobre</b> hoje. <span class="text-gold">Nomes reais no dia 1, por cortesia.</span></figcaption>
            <div class="phone">
              <span class="phone__notch" aria-hidden="true"></span>
              <div class="phone__screen ph-sobre">
                <p class="phone__url" aria-hidden="true">kiraodontologia.com.br/sobre</p>
                <div class="ph-cards" role="img" aria-label="Página Sobre da Kira no celular: quatro cartões de equipe com quadrado cinza no lugar da foto e o texto Nome Sobrenome, Cargo.">
                  {[1, 2, 3, 4].map(() => (
                    <div class="ph-card" aria-hidden="true"><span></span><b>Nome Sobrenome</b><small>Cargo</small></div>
                  ))}
                </div>
              </div>
              <span class="phone__tag"><i aria-hidden="true"></i>Rascunho no ar</span>
            </div>
          </figure>

          <!-- WhatsApp: hoje x depois -->
          <div class="ba wa-ba" data-ba data-state="hoje" data-reveal>
            <p class="k-cap"><b>Quando alguém indica vocês</b> no WhatsApp</p>
            <div class="ba-tabs" role="group" aria-label="Como o link chega no WhatsApp">
              <button type="button" class="ba-tab" data-ba-btn="hoje" aria-pressed="true">Hoje</button>
              <button type="button" class="ba-tab" data-ba-btn="depois" aria-pressed="false">Com a NOVRA</button>
            </div>
            <div class="wa" data-ba-frame>
              <div class="wa__head" aria-hidden="true">
                <span class="wa__av"></span>
                <span><b>Conversa</b><small>WhatsApp</small></span>
              </div>
              <div class="wa__body">
                <p class="wa__msg wa__msg--out">Conhece um dentista bom perto da Paulista?<span class="wa__time">14:31</span></p>
                <p class="wa__msg">Conheço! Olha essa:</p>
                <div class="wa__msg wa__link">
                  <span class="wa__card">
                    <span class="wa__real">
                      <img src="/proposta/kira/kira-recepcao.webp" alt="Recepção da Kira Odontologia com o letreiro iluminado." width="800" height="419" loading="lazy" />
                      <span class="wa__ct">
                        <b>Kira Odontologia</b>
                        <small>Implantes, facetas e Invisalign no Jardim Paulista</small>
                        <i aria-hidden="true">kiraodontologia.com.br</i>
                      </span>
                    </span>
                    <span class="wa__none">Sem foto e sem descrição</span>
                  </span>
                  <span class="wa__url">kiraodontologia.com.br</span>
                  <span class="wa__time">14:32</span>
                </div>
              </div>
            </div>
            <p class="ba-hint">Toque na conversa para comparar</p>
          </div>
        </div>

        <ul class="k-stats" data-reveal>
          {placar.map((p) => (
            <li class="k-stat">
              <p class="k-stat__n text-silver">
                {p.count !== undefined
                  ? <span data-count={p.count} data-decimals={p.decimals} data-suffix={p.suffix}>{p.fallback}</span>
                  : p.valor}
              </p>
              <p class="k-stat__l">{p.label}</p>
            </li>
          ))}
        </ul>

        <p class="k-rep" data-reveal>
          <Icon name="star" size={18} />
          <span><b>293 avaliações no Google.</b> A reputação já existe. O site precisa acompanhar.</span>
        </p>
        <p class="k-fine">Conferido no site da clínica em {EMITIDA}.</p>
      </div>
    </section>

    <!-- ===== ENTREGAS ===== -->
    <section class="k-sec k-ent" id="entregas">
      <span class="k-glow" aria-hidden="true"><span class="glow-orb k-ent__orb"></span></span>
      <div class="container">
        <div class="ent-top">
          <div class="k-head" data-reveal>
            <span class="eyebrow">O que vocês recebem</span>
            <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
            <h2 class="k-h2 balance">Três entregas, <span class="text-gradient">um projeto só.</span></h2>
            <p class="k-sub">O site, o blog e a bio da Akaki foram feitos pela NOVRA. Abaixo de cada entrega, o que ficou pronto lá.</p>
          </div>

          <!-- prévia ilustrativa da nova página da Kira -->
          <figure class="kv" data-reveal>
            <figcaption class="k-cap"><span class="kv__badge">Prévia ilustrativa</span> A nova página, com a recepção e a marca de vocês</figcaption>
            <div class="phone phone--kv">
              <span class="phone__notch" aria-hidden="true"></span>
              <div class="phone__screen kv__screen">
                <div class="kv__nav">
                  <img src="/proposta/kira/kira-logo-claro.svg" alt="Kira Odontologia" width="148" height="84" />
                  <span class="kv__burger" aria-hidden="true"><i></i><i></i></span>
                </div>
                <div class="kv__hero">
                  <img class="kv__bg" src="/proposta/kira/kira-recepcao-alta.webp" alt="" width="640" height="854" loading="lazy" />
                  <div class="kv__copy">
                    <span class="kv__eb">Jardim Paulista · SP</span>
                    <p class="kv__h">Clínica odontológica perto da Paulista</p>
                    <p class="kv__s">Implantes, facetas e Invisalign.</p>
                    <span class="kv__btn">Agendar pelo WhatsApp</span>
                    <span class="kv__btn kv__btn--o">Como chegar</span>
                  </div>
                </div>
                <div class="kv__chips" aria-hidden="true"><span>Implantes</span><span>Facetas</span><span>Invisalign</span></div>
              </div>
            </div>
          </figure>
        </div>

        <div class="ent-grid">
          {entregas.map((e) => (
            <article class="ent card card-accent" data-reveal>
              <i class="card-halo" aria-hidden="true"></i>
              <a class="ent__media" href={e.prova.url} target="_blank" rel="noopener" aria-label={`${e.titulo} da Akaki, feita pela NOVRA (abre em nova aba)`}>
                {e.prova.tipo === 'browser' ? (
                  <span class="bframe">
                    <span class="bframe__bar" aria-hidden="true"><i></i><i></i><i></i><span>{e.prova.label}</span></span>
                    <img src={`/proposta/kira/${e.prova.img}`} alt="" width={e.prova.w} height={e.prova.h} loading="lazy" style={`object-position: ${e.prova.pos}`} />
                  </span>
                ) : (
                  <span class="pframe">
                    <img src={`/proposta/kira/${e.prova.img}`} alt="" width={e.prova.w} height={e.prova.h} loading="lazy" />
                  </span>
                )}
                <span class="ent__prova">Na Akaki ficou assim <Icon name="arrow-up-right" size={14} /></span>
              </a>
              <div class="ent__top">
                <span class="k-ico"><Icon name={e.icon} /></span>
                <h3 class="ent__t">{e.titulo}</h3>
                <span class="ent__p">{e.preco}</span>
              </div>
              <ul class="k-checks">
                {e.pontos.map((t) => <li>{t}</li>)}
              </ul>
              <details class="disc ent__disc">
                <summary>E mais {e.mais.length} itens<span class="sr-only">: {e.titulo}</span> <span class="disc__c" aria-hidden="true"></span></summary>
                <ul class="disc__list">
                  {e.mais.map((t) => <li>{t}</li>)}
                </ul>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== PRAZO ===== -->
    <section class="k-sec k-prazo">
      <div class="container">
        <div class="k-head" data-reveal>
          <span class="eyebrow">Como funciona</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="k-h2 balance">No ar em <span class="text-gradient">10 dias úteis.</span></h2>
        </div>

        <div class="cal" data-cal data-reveal>
          <div class="cal__grid" role="img" aria-label="Calendário de duas semanas: dia 1 conversa, dias 2 a 4 desenho e textos, dia 5 aprovação, dias 6 a 8 construção, dias 9 e 10 no ar.">
            {semana.map((d) => <span class="cal__dow" aria-hidden="true">{d}</span>)}
            {diaEtapa.map((cls, i) => (
              <span class={`cal__day ${cls}`} style={`--i:${i}`} aria-hidden="true"><b>{i + 1}</b>{i === 9 && <small>No ar</small>}</span>
            ))}
          </div>
          <ol class="cal__leg">
            {etapas.map((s) => (
              <li class={s.cls}><i aria-hidden="true"></i><span class="cal__d">{s.dias}</span><b>{s.titulo}</b><small>{s.sub}</small></li>
            ))}
          </ol>
        </div>
        <p class="k-fine">Contando com o material no dia 1 e cada aprovação em até 1 dia útil.</p>
      </div>
    </section>

    <!-- ===== INVESTIMENTO ===== -->
    <section class="k-sec k-inv" id="investimento">
      <span class="k-glow" aria-hidden="true"><span class="glow-orb k-inv__orb"></span></span>
      <div class="container">
        <div class="inv card" data-inv data-reveal>
          <i class="card-halo" aria-hidden="true"></i>
          <h2 class="inv__head"><span class="eyebrow">Investimento</span></h2>
          <p class="inv__de"><span class="sr-only">De </span><s>R$ 4.300</s></p>
          <p class="inv__valor text-silver"><span class="sr-only">Por </span>R$ <span data-count="3784" data-decimals="0">3.784</span></p>
          <p class="inv__eco">Economia de R$ 516 por fechar as três</p>
          <p class="inv__cond">À vista · sem mensalidade<br />Válida até&nbsp;{VALIDA_ATE}</p>
          <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary btn-lg inv__btn" data-magnetic>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={WA_PATH} /></svg>
            Responder pelo WhatsApp
          </a>
          <details class="disc inv__disc">
            <summary>Ver por item <span class="disc__c" aria-hidden="true"></span></summary>
            <ul class="inv__lines">
              <li><span>Página principal</span><b>R$ 2.000</b></li>
              <li><span>Blog</span><b>R$ 1.500</b></li>
              <li><span>Links da bio</span><b>R$ 800</b></li>
              <li class="inv__desc"><span>Desconto de 12%</span><b>− R$ 516</b></li>
            </ul>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== DETALHES ===== -->
    <section class="k-sec k-termos">
      <div class="container">
        <div class="k-head" data-reveal>
          <span class="eyebrow">Detalhes</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="k-h2 balance">Para ler antes de aprovar.</h2>
        </div>

        <div class="termos" data-reveal>
          <details class="disc">
            <summary>Regras da odontologia <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <p>O site nasce dentro das regras do Conselho. Entram por obrigação a inscrição da clínica, o nome e o registro do responsável técnico e a identificação de Cirurgião-Dentista, tudo editável pela equipe.</p>
              <p class="disc__sub">Fica de fora, de propósito</p>
              <ul class="disc__list disc__list--no">
                <li>preço, “a partir de R$” ou parcelamento</li>
                <li>“avaliação gratuita” ou “primeira consulta grátis”</li>
                <li>promessa de resultado e “a melhor da região”</li>
                <li>foto de equipamento identificável e vídeo de procedimento</li>
                <li>a palavra “popular”, que a norma proíbe pelo nome</li>
              </ul>
              <p class="disc__sub">Passa pelo responsável técnico antes de ir ao ar</p>
              <ul class="disc__list">
                <li><b>Nome dos tratamentos.</b> Termos como “lente de contato dental” são questionados pelo Conselho. Recomendamos o nome técnico com o popular entre parênteses.</li>
                <li><b>Tratamentos com habilitação,</b> como sedação, só com o profissional habilitado identificado.</li>
                <li><b>Antes e depois.</b> Pela nossa leitura, é conteúdo do dentista que fez o tratamento, não da clínica. Se o entendimento for outro, o site se adapta.</li>
              </ul>
              <p class="disc__fine">Base: Código de Ética Odontológica (Resolução CFO-118/2012) e Resolução CFO-196/2019, com as atualizações de 2025. A validação final de qualquer conteúdo, inclusive da mensagem pronta do WhatsApp, é do responsável técnico. A NOVRA não é escritório jurídico.</p>
            </div>
          </details>

          <details class="disc">
            <summary>O que entra e o que fica fora <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <div class="duo">
                <div>
                  <p class="disc__sub disc__sub--yes">Entra</p>
                  <ul class="disc__list">
                    <li>As três peças, com textos escritos pela NOVRA</li>
