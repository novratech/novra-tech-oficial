</Site>

<script>
  // a prévia do site novo só rola enquanto está na tela
  const palco = document.querySelector('.k-prev__stage');
  if (palco) {
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => palco.classList.toggle('is-playing', e.isIntersecting)).observe(palco);
    else palco.classList.add('is-playing');
  }

  const bar = document.getElementById('kbar');
  const cta = document.getElementById('hero-cta');
  const alvos = ['valor', 'fim'].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  if (bar && cta && 'IntersectionObserver' in window) {
    let passou = false;
    const vistos = new Set<Element>();
    const atualiza = () => bar.classList.toggle('is-on', passou && vistos.size === 0);
    new IntersectionObserver(([e]) => {
      passou = !e.isIntersecting && e.boundingClientRect.top < 0;
      atualiza();
    }).observe(cta);
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? vistos.add(e.target) : vistos.delete(e.target)));
      atualiza();
    }, { rootMargin: '0px 0px -25% 0px' });
    alvos.forEach((a) => io.observe(a));
  }
</script>

<style>
  /* ---------- cabeçalho (mesmo vidro do site) ---------- */
