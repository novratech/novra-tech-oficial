    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.08);
  }
  .kh.is-over-light { background: rgba(0, 0, 0, 0.86); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
