    51%, 62% { transform: translateY(calc(var(--sec) * -3)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    68%, 81% { transform: translateY(calc(var(--sec) * -4)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    89%, 100% { transform: translateY(0); }
