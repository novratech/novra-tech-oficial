  /* ---------- topo ---------- */
  .k-hero { position: relative; padding-top: calc(var(--header-h) + clamp(3.5rem, 2rem + 5vw, 7rem)); padding-bottom: clamp(4rem, 3rem + 4vw, 7rem); overflow: hidden; }
  .k-hero__t {
    margin-top: 1rem;
    font-family: var(--font-display); font-weight: 300;
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 5.25rem);
    line-height: 1.03; letter-spacing: -0.02em; color: var(--fg);
  }
  .k-hero__lead { margin-top: 1.5rem; max-width: 36em; }
  .k-hero__facts { display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem; margin-top: 1.75rem; list-style: none; font-size: 15px; color: var(--fg); }
  .k-hero__facts li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .k-hero__facts :global(svg) { color: var(--link-c); }
  .k-hero__btns { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }

  /* ---------- prévia do site novo da Kira ---------- */
  .k-prev { margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem); }
  /* o celular da bio encosta só na margem direita do computador, sem esconder conteúdo */
  .k-prev__stage { position: relative; padding: 0 15% 6% 0; }
  .k-prev__desk { aspect-ratio: 16 / 10; width: 100%; background: #fbf9f6; }
  .k-prev__mob { display: none; }
