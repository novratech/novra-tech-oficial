---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import logoKiraRaw from '../../../public/proposta/kira/kira-logo-claro.svg?raw';

// Proposta comercial da Kira Odontologia (noindex), no visual novo da NOVRA: curta, para ler em
// um minuto ou passar no Meet. Valores, prazo e validade são do Felipe; não mudar sem ele.
// O "hoje" foi reconferido no site da clínica em 04/10/2026: título "Kira" no Google, link sem
// prévia no WhatsApp, equipe "Nome Sobrenome" na página Sobre e último artigo de 22/05/2026.

const WHATSAPP = '5511998002960';
const WHATSAPP_FMT = '(11) 99800-2960';
const EMAIL = 'contato@novratech.com.br';
const EMITIDA = '01/10/2026';
const VALIDA_ATE = '08/10/2026';
const CONFERIDO = '04/10/2026';

const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
const waAprovar = wa('Olá, aqui é da Kira Odontologia. Vimos a proposta do site novo (página principal, blog e links da bio, R$ 3.784 à vista) e queremos aprovar. Qual é o próximo passo?');
const waDuvida = wa('Olá, aqui é da Kira Odontologia. Vimos a proposta do site novo e temos uma dúvida.');
const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent('Proposta Kira Odontologia')}`;

// a logo só existe na versão para fundo escuro (letras brancas e anel champanhe);
// na prévia clara as letras herdam a cor do texto
const logoKira = logoKiraRaw.replace(/<\?xml[^>]*>\s*/, '').replace('fill="white"', 'fill="currentColor"');

// tratamentos que a Kira já lista no site dela; "lentes de contato" vai pelo nome técnico, como pede o CFO
const tratamentos = ['Implantes', 'Facetas em resina', 'Facetas de porcelana', 'Invisalign', 'Estética avançada', 'Manutenção periodontal'];

const entregas = [
  { titulo: 'Página principal', preco: 'R$ 2.000', itens: ['Um bloco claro para cada tratamento', 'Equipe com foto, nome e CRO', 'WhatsApp e rota com um toque'] },
  { titulo: 'Blog', preco: 'R$ 1.500', itens: ['Os 10 artigos de hoje com visual novo, separados por assunto', 'Artigos assinados por dentista, com CRO', 'Modelo pronto e vídeo para a equipe publicar sozinha'] },
  { titulo: 'Links da bio', preco: 'R$ 800', itens: ['Com a marca e as fotos da Kira, dentro do site da Kira', 'WhatsApp com mensagem pronta, rota e tratamentos', 'A própria equipe atualiza quando quiser'] },
];

const prazo = [
  { dia: 'Dia 1', txt: 'Uma conversa de 1 hora. Vocês mandam as fotos e os acessos.' },
  { dia: 'Dias 2 a 9', txt: 'Escrevemos os textos e montamos as três peças. Vocês aprovam em duas rodadas.' },
  { dia: 'Dia 10', txt: 'Tudo no ar, com o treinamento da equipe.' },
];

const simples = [
  { icon: 'quote', b: 'Os textos são por nossa conta.', t: 'Vocês mandam as fotos e aprovam, com duas rodadas de ajuste.' },
  { icon: 'layers', b: 'Nada se perde.', t: 'Os 10 artigos continuam, os links antigos seguem abrindo e guardamos uma cópia do site atual.' },
  { icon: 'security', b: 'Dentro das regras do CFO.', t: 'Sem preço, sem “avaliação gratuita”, sem promessa de resultado e sem antes e depois.' },
  { icon: 'handshake', b: 'Tudo no nome da clínica.', t: 'Domínio e hospedagem seguem com vocês, e a equipe aprende a atualizar.' },
];

const valores = [
  ['Página principal', 'R$ 2.000'],
  ['Blog', 'R$ 1.500'],
  ['Links da bio', 'R$ 800'],
];

const passos = ['Vocês aprovam pelo WhatsApp.', 'Combinamos o pagamento e mandamos a lista do que precisamos.', 'Em 10 dias úteis, o site novo está no ar.'];

const detalhes = {
  entra: [
    'Página principal: um bloco para cada tratamento; equipe com foto, nome e CRO; WhatsApp e rota em um toque; perguntas frequentes, mapa, horário e estacionamento; nome certo no Google e prévia com foto quando alguém compartilha o link; links antigos continuam abrindo.',
    'Blog: os 10 artigos reorganizados, com visual novo e listagem por assunto; lista de temas dentro das regras do CFO; artigos assinados por dentista, com CRO; modelo de artigo e vídeo ensinando a equipe a publicar.',
    'Links da bio: com a marca e as fotos da Kira, dentro do site da Kira; WhatsApp com mensagem pronta, rota e tratamentos; contagem de cliques sem identificar ninguém; edição pela própria equipe.',
    'Textos escritos pela NOVRA, com duas rodadas de ajuste.',
    'Até 40 fotos enviadas pela clínica, tratadas e organizadas.',
    'Política de privacidade e aviso de cookies.',
    'Formulário que chega no e-mail e no WhatsApp da clínica.',
    'Medição de visitas no site e de cliques na bio.',
    'Cópia de segurança do site atual.',
    '30 dias de correção de defeito: link quebrado, bloco que não abre no celular, formulário que não chega.',
    'Treinamento em vídeo e meia hora ao vivo.',
  ],
  fora: [
    'Perfil da Empresa no Google (orientamos sem custo).',
    'Reescrever as páginas internas de cada tratamento, que seguem no ar com o visual atual.',
    'Artigos novos depois da entrega.',
    'Instagram, anúncios e disparo de mensagens.',
    'Sessão de fotos (entregamos o roteiro para o fotógrafo).',
    'Agendamento online e atendimento automático.',
    'Validação jurídica da política de privacidade.',
    'Domínio e hospedagem, que seguem no nome da clínica.',
    'Mudanças depois da segunda aprovação.',
    'Promessa de posição no Google, de visitas ou de pacientes.',
  ],
  prazo: [
    'Material completo no dia 1: fotos, dados da equipe e acesso ao site e ao domínio. Se o acesso atrasar, o prazo conta a partir da liberação.',
    'Uma pessoa da Kira aprova cada etapa em até 1\u00a0dia útil.',
    'Hospedagem que aguente o site novo. Conferimos no dia 1, sem custo; se precisar trocar, vocês sabem o valor antes.',
    'Fotos com uso autorizado. Paciente identificável, só com autorização por escrito.',
    'Se a espera por material ou aprovação passar de 10\u00a0dias corridos, o projeto pausa e volta na primeira data livre, sem mudar o valor, desde que a retomada aconteça em até 90\u00a0dias.',
  ],
  perguntas: [
    ['Vamos precisar escrever os textos?', 'Não. Escrevemos tudo e vocês aprovam, com duas rodadas de ajuste.'],
    ['Vamos perder os artigos e os links de hoje?', 'Não. Os 10 artigos são reorganizados, os links antigos continuam abrindo e guardamos uma cópia de segurança do site atual.'],
    ['Tem mensalidade?', 'Não. O pagamento é único, R$\u00a03.784 à vista. Domínio e hospedagem seguem no nome da clínica.'],
    ['Dá para parcelar?', 'A proposta é para pagamento à vista. Se precisar parcelar, fale conosco antes de aprovar.'],
    ['A equipe consegue atualizar sozinha?', 'Sim. Tem treinamento em vídeo, meia hora ao vivo e um modelo pronto de artigo. A página de links da bio também é editada pela própria equipe.'],
    ['Vocês garantem pacientes ou primeira posição no Google?', 'Não. Ninguém pode prometer isso com honestidade. O que entregamos é um site que facilita a paciente achar a Kira, confiar na equipe e marcar.'],
  ],
};
---

<Site
  title="Proposta · Kira Odontologia · NOVRA"
  socialTitle="Proposta NOVRA · O site novo da Kira Odontologia"
  description="Página principal, blog e links da bio da Kira Odontologia refeitos com a marca e as fotos da clínica, no ar em 2 semanas. Proposta válida até 08/10/2026."
  noindex
  image="/proposta/kira/og.jpg"
  imageAlt="Proposta da NOVRA para o site novo da Kira Odontologia"
>
  <!-- cabeçalho próprio: o da home aponta para âncoras que só existem lá -->
  <header class="kh" id="site-header" data-state="top">
    <div class="kh__in">
      <a href="/" class="kh__brand" aria-label="NOVRA, página inicial">
        <img src="/brand/novra-logo-branco.svg" alt="NOVRA" width="115" height="30" />
      </a>
      <span class="kh__x" aria-hidden="true">×</span>
      <span class="kh__cli">Kira Odontologia</span>
      <a href="#valor" class="btn btn-primary btn-sm kh__cta">Ver o valor</a>
    </div>
  </header>

  <main id="main">
    <!-- ===== TOPO: o que é, prazo, valor e a prévia ===== -->
    <section class="k-hero" aria-labelledby="k-hero-t">
      <div class="container k-hero__in">
        <p class="eyebrow" data-reveal>Proposta para a Kira Odontologia</p>
        <h1 class="k-hero__t balance" id="k-hero-t" data-reveal style="--d: 60ms">
          O site novo da Kira. <span class="tone">No ar em 2 semanas.</span>
        </h1>
        <p class="lead k-hero__lead pretty" data-reveal style="--d: 120ms">
          Página principal, blog e links da bio refeitos com a marca e as fotos da Kira. Para a paciente achar a clínica, confiar na equipe e marcar pelo WhatsApp com um toque.
        </p>
        <ul class="k-hero__facts" data-reveal style="--d: 160ms">
          <li><Icon name="check" size={16} strokeWidth={2} /> R$ 3.784 à vista</li>
          <li><Icon name="check" size={16} strokeWidth={2} /> Sem mensalidade</li>
          <li><Icon name="check" size={16} strokeWidth={2} /> Válida até {VALIDA_ATE}</li>
        </ul>
        <div class="k-hero__btns" id="hero-cta" data-reveal style="--d: 200ms">
          <a href="#valor" class="btn btn-primary btn-lg">Ver o investimento</a>
          <a href={waDuvida} class="btn btn-secondary btn-lg" target="_blank" rel="noopener" aria-label="Falar no WhatsApp (abre em nova aba)">
            <Icon name="whatsapp" /> Falar no WhatsApp
          </a>
        </div>
      </div>

      <!-- prévia ilustrativa do site novo: montada em código (fica nítida em qualquer tela) -->
      <figure class="container k-prev" data-reveal style="--d: 260ms">
        <div class="k-prev__stage" role="img" aria-label="Prévia ilustrativa do site novo da Kira Odontologia, rolando sozinha: o topo com a recepção, os tratamentos, a clínica por dentro, a equipe e como chegar; ao lado, a página de links da bio no celular.">
          {['desk', 'mob'].map((v) => (
            <div class={`screen k-prev__${v}`} aria-hidden="true">
              <div class="km">
                <div class="km__nav">
                  <span class="km__logo" set:html={logoKira} />
                  <span class="km__links"><span>Tratamentos</span><span>A clínica</span><span>Equipe</span><span>Blog</span><span>Contato</span></span>
                  <span class="km__cta">Agendar</span>
                  <span class="km__burger"><i></i><i></i></span>
                </div>
                <div class="km__view">
                  <div class="km__page">
                    <section class="km__s km__hero">
                      <img class="km__bg" src="/proposta/kira/kira-recepcao-larga.webp" alt="" width="1280" height="960" />
                      <span class="km__heroc">
                        <span class="km__eb km__eb--light">Jardim Paulista · São Paulo</span>
                        <span class="km__h1">Clínica odontológica perto da Paulista.</span>
                        <span class="km__sub">Implantes, facetas, Invisalign e estética, com hora marcada pelo WhatsApp.</span>
                        <span class="km__btns"><span class="km__btn km__btn--gold">Agendar pelo WhatsApp</span><span class="km__btn km__btn--ol">Como chegar</span></span>
                      </span>
                    </section>
                    <section class="km__s km__trat">
                      <span class="km__eb">Tratamentos</span>
                      <span class="km__h2">Do implante à estética do sorriso.</span>
                      <span class="km__grid">
                        {tratamentos.map((t, i) => <span class="km__card"><small>{String(i + 1).padStart(2, '0')}</small><b>{t}</b><em>Saiba mais ›</em></span>)}
                      </span>
                    </section>
                    <section class="km__s km__clin">
                      <span class="km__eb">A clínica</span>
                      <span class="km__h2">Por dentro da Kira.</span>
                      <span class="km__fotos">
                        <img src="/proposta/kira/kira-consultorio-1.webp" alt="" width="960" height="1280" />
                        <img src="/proposta/kira/kira-recepcao-2.webp" alt="" width="960" height="1280" />
                        <img src="/proposta/kira/kira-consultorio-2.webp" alt="" width="960" height="1280" />
                      </span>
                    </section>
                    <section class="km__s km__eq">
                      <span class="km__eqc">
                        <span class="km__eb">Equipe</span>
                        <span class="km__h2">Quem cuida de você.</span>
                        <span class="km__p">Conheça quem vai cuidar do seu sorriso, do primeiro atendimento ao retorno.</span>
                        <span class="km__more">Conheça a equipe ›</span>
                      </span>
                      <span class="km__retratos">
                        <img src="/proposta/kira/kira-equipe-1.webp" alt="" width="800" height="1106" />
                        <img src="/proposta/kira/kira-equipe-2.webp" alt="" width="640" height="1251" />
                      </span>
                    </section>
                    <section class="km__s km__vis">
                      <span class="km__visc">
                        <span class="km__eb km__eb--light">Como chegar</span>
                        <span class="km__h2 km__h2--light">Perto da Av. Paulista.</span>
                        <span class="km__addr">Rua Pamplona, 1119, conj. 32<br />Jardim Paulista, São Paulo</span>
                        <span class="km__btns"><span class="km__btn km__btn--gold">Agendar pelo WhatsApp</span><span class="km__btn km__btn--ol">Abrir no mapa</span></span>
                      </span>
                      <span class="km__map">
                        <i class="km__road km__road--a"></i><i class="km__road km__road--b"></i><i class="km__road km__road--c"></i><i class="km__road km__road--d"></i>
                        <span class="km__ml km__ml--a">Av. Paulista</span><span class="km__ml km__ml--b">R. Pamplona</span>
                        <span class="km__pin"></span>
                      </span>
                    </section>
                    <span class="km__foot"><img src="/proposta/kira/kira-logo-claro.svg" alt="" width="148" height="84" /><span>Rua Pamplona, 1119, conj. 32 · Jardim Paulista, São Paulo</span></span>
                  </div>
                </div>
                <span class="km__wa"><Icon name="whatsapp" /></span>
              </div>
            </div>
          ))}
          <div class="screen k-prev__phone" aria-hidden="true">
            <div class="kb">
              <div class="kb__top">
                <img class="kb__ph" src="/proposta/kira/kira-recepcao-2.webp" alt="" width="960" height="1280" />
                <img class="kb__logo" src="/proposta/kira/kira-logo-claro.svg" alt="" width="148" height="84" />
              </div>
              <p class="kb__name">Kira Odontologia</p>
              <p class="kb__sub">Jardim Paulista · São Paulo</p>
              <span class="kb__links">
                <span class="kb__link kb__link--main">Agendar pelo WhatsApp</span>
                <span class="kb__link">Como chegar</span>
                <span class="kb__link">Tratamentos</span>
                <span class="kb__link">Blog da Kira</span>
                <span class="kb__link">Site completo</span>
              </span>
              <p class="kb__end">Rua Pamplona, 1119 · Jardim Paulista</p>
            </div>
          </div>
        </div>
        <figcaption class="caption k-prev__cap">Prévia ilustrativa. A versão final usa as fotos e os textos aprovados pela clínica.</figcaption>
      </figure>
    </section>

    <!-- ===== O QUE ESTÁ INCLUÍDO ===== -->
    <section class="section theme-light sheet k-ent" id="entregas" aria-labelledby="k-ent-t">
      <div class="container">
        <header class="head k-head" data-reveal>
          <p class="eyebrow">O que está incluído</p>
          <h2 class="h2 balance" id="k-ent-t">Três peças, um só visual. <span class="tone">Tudo com a cara da Kira.</span></h2>
        </header>
        <ul class="en">
          {entregas.map((e, i) => (
            <li class="en__card" data-reveal style={`--d: ${i * 80}ms`}>
              <div class="en__top">
                <h3 class="en__t">{e.titulo}</h3>
                <span class="en__p">{e.preco}</span>
              </div>
              <ul class="en__list">
                {e.itens.map((t) => <li><Icon name="check" size={18} strokeWidth={2} /> <span>{t}</span></li>)}
              </ul>
            </li>
          ))}
        </ul>
        <p class="en__note" data-reveal>
          <span>Os três juntos saem por <strong>R$ 3.784 à vista</strong>, com 12% de desconto.</span>
          <a href="#valor" class="more">Ver o investimento <Icon name="chevron-right" strokeWidth={2} /></a>
        </p>
      </div>
    </section>

    <!-- ===== O QUE MUDA PARA A PACIENTE ===== -->
    <section class="section k-mu" aria-labelledby="k-mu-t">
      <div class="container">
        <header class="head k-head" data-reveal>
          <p class="eyebrow">Para a paciente</p>
          <h2 class="h2 balance" id="k-mu-t">Achar. Confiar. Marcar. <span class="tone">O que muda para quem procura a Kira.</span></h2>
        </header>

        <ol class="mu">
          <li class="mu__row" data-reveal>
            <p class="mu__v">Achar</p>
            <div class="mu__col">
              <span class="mu__lbl">Hoje</span>
              <p class="mu__txt">No Google, o site aparece só como “Kira”.</p>
              <div class="g g--hoje" aria-hidden="true">
                <div class="g__site"><img src="/proposta/kira/kira-icone.webp" alt="" width="72" height="72" /><span><b>kiraodontologia.com.br</b><small>https://kiraodontologia.com.br</small></span></div>
                <p class="g__t">Kira</p>
                <p class="g__miss">Texto escolhido pelo Google, não pela clínica.</p>
              </div>
            </div>
            <div class="mu__col mu__col--novo">
              <span class="mu__lbl"><i aria-hidden="true"></i>Com o site novo</span>
              <p class="mu__txt">Aparece com o nome da clínica e o que ela faz.</p>
              <div class="g" aria-hidden="true">
                <div class="g__site"><img src="/proposta/kira/kira-icone.webp" alt="" width="72" height="72" /><span><b>Kira Odontologia</b><small>https://kiraodontologia.com.br</small></span></div>
                <p class="g__t">Kira Odontologia · Implantes e estética no Jardim Paulista</p>
                <p class="g__d">Clínica odontológica no Jardim Paulista, perto da Av. Paulista. Implantes, facetas e Invisalign. Agende pelo WhatsApp.</p>
              </div>
            </div>
          </li>

          <li class="mu__row" data-reveal>
            <p class="mu__v">Confiar</p>
            <div class="mu__col">
              <span class="mu__lbl">Hoje</span>
              <p class="mu__txt">Uma imagem feita por IA na página inicial e a equipe escrita “Nome Sobrenome”.</p>
            </div>
            <div class="mu__col mu__col--novo">
              <span class="mu__lbl"><i aria-hidden="true"></i>Com o site novo</span>
              <p class="mu__txt">Fotos da clínica de verdade e cada dentista com foto, nome e CRO.</p>
            </div>
          </li>

          <li class="mu__row" data-reveal>
            <p class="mu__v">Marcar</p>
            <div class="mu__col">
              <span class="mu__lbl">Hoje</span>
              <p class="mu__txt">O link mandado pelo WhatsApp chega sem foto e sem descrição.</p>
              <div class="wz" aria-hidden="true">
                <p class="wz__msg">Olha essa clínica: <u>kiraodontologia.com.br</u></p>
              </div>
            </div>
            <div class="mu__col mu__col--novo">
              <span class="mu__lbl"><i aria-hidden="true"></i>Com o site novo</span>
              <p class="mu__txt">Chega com foto e descrição, e o WhatsApp e a rota ficam a um toque.</p>
              <div class="wz" aria-hidden="true">
                <div class="wz__card">
                  <img src="/proposta/kira/kira-recepcao.webp" alt="" width="800" height="419" />
                  <span><b>Kira Odontologia · Implantes e estética no Jardim Paulista</b><small>kiraodontologia.com.br</small></span>
                </div>
                <p class="wz__msg">Olha essa clínica: <u>kiraodontologia.com.br</u></p>
              </div>
            </div>
          </li>
        </ol>
        <p class="caption mu__fine" data-reveal>Conferido no site da clínica em {CONFERIDO}.</p>
      </div>
    </section>

    <!-- ===== PROVA ===== -->
    <section class="section theme-light is-gray sheet k-prova" aria-labelledby="k-prova-t">
      <div class="container">
        <header class="head k-head" data-reveal>
          <p class="eyebrow">Já está no ar</p>
          <h2 class="h2 balance" id="k-prova-t">Já fizemos isso para outra clínica.</h2>
          <p class="lead pretty">Construímos, conferimos e publicamos o site, o blog e a página de links da bio da Akaki Odontologia. É o mesmo conjunto que propomos para a Kira, e dá para abrir agora.</p>
          <a href="https://akaki.odo.br/" class="more" target="_blank" rel="noopener">Ver o site da Akaki <Icon name="chevron-right" strokeWidth={2} /></a>
        </header>
        <div class="pv">
          <figure class="pv__item" data-reveal>
            <div class="screen pv__shot"><img src="/proposta/kira/akaki-galeria.webp" alt="Página principal da Akaki Odontologia no computador" width="1440" height="668" loading="lazy" style="object-position: left top" /></div>
            <figcaption class="caption">Página principal</figcaption>
          </figure>
          <figure class="pv__item" data-reveal style="--d: 80ms">
            <div class="screen pv__shot"><img src="/proposta/kira/akaki-blog.webp" alt="Blog da Akaki Odontologia, com busca e filtros por assunto" width="1600" height="1000" loading="lazy" style="object-position: center top" /></div>
            <figcaption class="caption">Blog</figcaption>
          </figure>
          <figure class="pv__item pv__item--tall" data-reveal style="--d: 160ms">
            <div class="screen pv__shot"><img src="/proposta/kira/akaki-bio-recorte.webp" alt="Página de links da bio da Akaki Odontologia no celular" width="860" height="1225" loading="lazy" style="object-position: center top" /></div>
            <figcaption class="caption">Links da bio</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== PRAZO ===== -->
    <section class="section k-pz" aria-labelledby="k-pz-t">
      <div class="container">
        <header class="head k-head" data-reveal>
          <p class="eyebrow">Prazo</p>
          <h2 class="h2 balance" id="k-pz-t">Pronto em 2 semanas. <span class="tone">Quase sem trabalho para vocês.</span></h2>
          <p class="lead pretty">São 10 dias úteis, contando com o material completo no dia 1 e cada aprovação em até 1&nbsp;dia útil.</p>
        </header>
        <ol class="pz" data-reveal>
          {prazo.map((p, i) => (
            <li class:list={['pz__step', { 'is-end': i === prazo.length - 1 }]}>
              <span class="pz__dot" aria-hidden="true"></span>
              <b class="pz__dia">{p.dia}</b>
              <p class="pz__txt">{p.txt}</p>
            </li>
          ))}
        </ol>
        <ul class="sp">
          {simples.map((s, i) => (
            <li class="sp__item" data-reveal style={`--d: ${i * 60}ms`}>
              <Icon name={s.icon} size={26} />
