---
import Site from '../layouts/Site.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/home/Manifesto.astro';
import Solucoes from '../components/home/Solucoes.astro';
import Clientes from '../components/home/Clientes.astro';
import Processo from '../components/home/Processo.astro';
import Contato from '../components/home/Contato.astro';
import Footer from '../components/Footer.astro';
---
<Site>
  <Header />
  <main id="main">
    <Hero />
    <!-- o manifesto fica parado enquanto a folha clara de Soluções sobe por cima dele -->
    <div class="stack">
      <Manifesto />
      <Solucoes />
    </div>
    <Clientes />
    <Processo />
    <Contato />
  </main>
  <Footer />
</Site>
