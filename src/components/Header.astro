---
import Icon from './Icon.astro';

// no desktop, "Fale conosco" já leva ao Contato; no menu do celular o Contato entra na lista
const nav = [
  { label: 'Soluções', href: '#solucoes' },
  { label: 'Clientes', href: '#clientes' },
  { label: 'Como trabalhamos', href: '#processo' },
];
const menuNav = [...nav, { label: 'Contato', href: '#contato' }];
const WHATSAPP = 'https://wa.me/5511998002960?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20NOVRA%20e%20quero%20conversar%20sobre%20um%20projeto.';
---
<header class="nav" id="site-header" data-state="top">
  <div class="nav__inner">
    <a href="#topo" class="nav__brand" aria-label="NOVRA, ir para o início">
      <img src="/brand/novra-logo-branco.svg" alt="" width="115" height="30" />
    </a>

    <nav class="nav__links" aria-label="Principal">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav__actions">
      <!-- leva ao Contato, onde estão as duas saídas: diagnóstico e WhatsApp -->
      <a href="#contato" class="btn btn-primary btn-sm nav__cta">Fale conosco</a>
      <button class="nav__toggle" id="nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- fora do <header> de propósito: o backdrop-filter do cabeçalho viraria o bloco de
     contenção do position:fixed e o menu ficaria cortado -->
<div class="menu" id="mobile-menu" role="dialog" aria-label="Menu" hidden>
  <nav class="menu__links" aria-label="Seções">
    {menuNav.map((item, i) => <a href={item.href} style={`--i:${i}`}>{item.label}</a>)}
  </nav>
  <div class="menu__foot">
    <a href="/formulario" class="btn btn-primary btn-lg">Solicitar diagnóstico</a>
    <a href={WHATSAPP} class="more" target="_blank" rel="noopener" aria-label="WhatsApp (11) 99800-2960 (abre em nova aba)">
      <Icon name="whatsapp" size={18} /> WhatsApp <span class="nowrap">(11) 99800-2960</span>
    </a>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--header-h);
    transition: background-color 0.3s var(--ease-ui), box-shadow 0.3s var(--ease-ui);
  }
  .nav[data-state='scrolled'] {
    background: rgba(0, 0, 0, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.08);
  }
  /* sobre as seções claras o vidro fecha mais: o logo cromado precisa de fundo escuro */
  .nav.is-over-light { background: rgba(0, 0, 0, 0.86); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav[data-state='scrolled'] { background: rgba(0, 0, 0, 0.94); }
  }
  /* sem JavaScript: cabeçalho sempre com fundo, sem botão de menu morto e com a pílula visível */
  :global(html:not(.js)) .nav { background: rgba(0, 0, 0, 0.86); }
  :global(html:not(.js)) .nav__toggle { display: none; }
  :global(html:not(.js)) .nav .nav__cta { position: static; opacity: 1; visibility: visible; transform: none; pointer-events: auto; }

  .nav__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    height: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .nav__brand { display: inline-flex; align-items: center; height: 44px; }
  .nav__brand img { height: 30px; width: auto; }

  .nav__links { display: none; gap: 2rem; }
  .nav__links a {
    font-size: 14px; letter-spacing: -0.01em;
    color: rgba(245, 245, 247, 0.8);
    transition: color 0.2s var(--ease-ui);
  }
  .nav__links a:hover { color: #f5f5f7; }

  .nav__actions { position: relative; display: flex; align-items: center; gap: 0.25rem; }

  /* a pílula só entra quando o botão do hero sai da tela (nunca dois botões azuis juntos);
     escondida, ela sai do fluxo para não empurrar o botão do menu */
  .nav__cta { transition: opacity 0.3s var(--ease-ui), transform 0.3s var(--ease-ui), background-color 0.2s var(--ease-ui); }
  .nav:not(.show-cta) .nav__cta,
  .nav.menu-open .nav__cta {
    opacity: 0; transform: translateY(-4px); pointer-events: none; visibility: hidden;
  }
  @media (max-width: 833px) {
    .nav:not(.show-cta) .nav__cta,
    .nav.menu-open .nav__cta { position: absolute; right: 0; }
  }

  .nav__toggle {
    display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px;
    width: 44px; height: 44px; margin-right: -12px;
  }
  /* linhas desenhadas com borda: continuam visíveis em alto contraste (cores forçadas) */
  .nav__toggle span {
    display: block; width: 18px; height: 0; border-top: 1.5px solid #f5f5f7;
    transition: transform 0.3s var(--ease-ui);
  }
  .nav.menu-open .nav__toggle span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav.menu-open .nav__toggle span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav.menu-open { background: #000; box-shadow: none; }
  @media (forced-colors: active) {
    .nav__toggle span { border-top-color: CanvasText; }
  }

  /* menu do celular: camada opaca, sem blur de tela cheia */
  .menu {
    position: fixed; inset: 0; z-index: 90;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    padding: calc(var(--header-h) + 2.5rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background: #000;
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.32s var(--ease-ui);
  }
  .menu[hidden] { display: none; }
  .menu.is-open { opacity: 1; }
  .menu__links { display: flex; flex-direction: column; gap: 1.25rem; }
  .menu__links a {
    font-size: 28px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.1;
    color: #f5f5f7;
    opacity: 0; transform: translateY(8px);
  }
  .menu.is-open .menu__links a {
    opacity: 1; transform: none;
    transition: opacity 0.4s var(--ease-out) calc(var(--i) * 40ms + 60ms), transform 0.4s var(--ease-out) calc(var(--i) * 40ms + 60ms);
  }
  .menu__foot { display: flex; flex-direction: column; align-items: stretch; gap: 1.25rem; }
  .menu__foot .more { justify-content: center; min-height: 44px; }
  .menu__foot .more :global(svg) { width: 18px; height: 18px; }

  @media (min-width: 834px) {
    .nav__links { display: flex; }
    .nav__toggle { display: none; }
    .menu { display: none !important; }
  }
  @media (max-width: 833px) {
    /* no celular a pílula fica mais leve que o logo */
    .nav__cta { min-height: 28px; padding: 0 0.75rem; font-size: 12px; }
  }
  @media (max-width: 733px) {
    .nav__brand img { height: 26px; }
  }
</style>
