---

const year = new Date().getFullYear();
const WHATSAPP = 'https://wa.me/5511998002960?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20NOVRA%20e%20quero%20conversar%20sobre%20um%20projeto.';
// e-mail e horário de atendimento só voltam quando estiverem confirmados
const navegue = [
  { label: 'Soluções', href: '#solucoes' },
  { label: 'Clientes', href: '#clientes' },
  { label: 'Como trabalhamos', href: '#processo' },
  { label: 'Contato', href: '#contato' },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/brand/novra-logo-branco.svg" alt="NOVRA" width="100" height="26" />
        <p>Sistemas inteligentes para a próxima era.</p>
      </div>
      <nav class="footer__col" aria-label="Rodapé">
        <h2>Navegue</h2>
        <ul>{navegue.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div class="footer__col">
        <h2>Fale com a NOVRA</h2>
        <ul>
          <li><a href="/formulario">Solicitar diagnóstico</a></li>
          <li><a href={WHATSAPP} target="_blank" rel="noopener" aria-label="WhatsApp (11) 99800-2960 (abre em nova aba)">WhatsApp <span class="nowrap">(11) 99800-2960</span></a></li>
          <li><a href="https://www.instagram.com/novratech.oficial" target="_blank" rel="noopener" aria-label="Instagram @novratech.oficial (abre em nova aba)">Instagram <span class="nowrap">@novratech.oficial</span></a></li>
          <li class="footer__muted">São Paulo, Brasil</li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© {year} NOVRA. Todos os direitos reservados.</p>
      <a href="#topo">Voltar ao topo</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: #000;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: clamp(3rem, 2rem + 3vw, 4rem);
    font-size: 14px;
    letter-spacing: -0.006em;
  }
  .footer__top {
    display: grid; grid-template-columns: 1fr; gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .footer__brand img { height: 26px; width: auto; }
  .footer__brand p { margin-top: 1rem; color: #86868b; }
  .footer__col h2 { font-size: 14px; font-weight: 600; color: #f5f5f7; letter-spacing: -0.006em; }
  .footer__col ul { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.9rem; }
  .footer__col a { color: #86868b; transition: color 0.2s var(--ease-ui); }
  .footer__col a:hover { color: #f5f5f7; }
  .footer__muted { color: #86868b; }
  .footer__bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 12px; color: #86868b;
  }
  .footer__bottom a { color: #86868b; }
  .footer__bottom a:hover { color: #f5f5f7; }

  @media (min-width: 735px) {
    .footer__top { grid-template-columns: 2fr 1fr 1fr; }
  }
  @media (max-width: 734px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
    /* alvos de toque confortáveis no celular */
    .footer__col ul { gap: 0; }
    .footer__col a, .footer__bottom a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 44px; }
  }
</style>
